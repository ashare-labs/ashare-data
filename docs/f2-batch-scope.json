  "universe_reason": "Nonfinancial issuer panel selected before calculation; current/noncurrent balance-sheet presentation required. Banks/insurers not silently treated as missing industrial issuers. Retrospective survivor-selected diagnostic universe.",
  "fields": {
    "BIAS5": {
      "category": "short_horizon_mean_deviation",
      "formula": "100 * (close / mean(close,5) - 1)",
      "inputs": [
        "close",
        "effective_price_factor"
      ],
      "sessions": 5,
      "atol": 0.01,
      "rtol": 0.001
    },
    "CCI20": {
      "category": "price_distribution_oscillator",
      "formula": "(TP[-1]-mean(TP,20))/(0.015*mean(abs(TP-mean(TP,20)),20)); TP=(high+low+close)/3",
      "inputs": [
        "high",
        "low",
        "close",
        "effective_price_factor"
      ],
      "sessions": 20,
      "atol": 0.1,
      "rtol": 0.001
    },
    "PSY": {
      "category": "up_day_frequency",
      "formula": "100 * count(close[t]>close[t-1] over last12 changes)/12; equal closes are not up",
      "inputs": [
        "close",
        "effective_price_factor"
      ],
      "sessions": 13,
      "atol": 1e-06,
      "rtol": 0
    },
    "quick_ratio": {
      "category": "short_term_liquidity",
      "formula": "(TOTAL_CURRENT_ASSETS-INVENTORY)/TOTAL_CURRENT_LIAB",
      "inputs": [
        "balance:TOTAL_CURRENT_ASSETS",
        "balance:INVENTORY",
        "balance:TOTAL_CURRENT_LIAB"
      ],
      "atol": 1e-06,
      "rtol": 0.0001
    },
    "debt_to_asset_ratio": {
      "category": "balance_sheet_leverage",
      "formula": "TOTAL_LIABILITIES/TOTAL_ASSETS",
      "inputs": [
        "balance:TOTAL_LIABILITIES",
        "balance:TOTAL_ASSETS"
      ],
      "atol": 1e-06,
      "rtol": 0.0001
    },
    "net_operating_cash_flow_coverage": {
      "category": "cash_earnings_quality",
      "formula": "single-quarter NETCASH_OPERATE / single-quarter PARENT_NETPROFIT; cumulative difference for Q2/Q3/Q4; same latest visible report period across both inputs",
      "inputs": [
        "cash:NETCASH_OPERATE",
        "income:PARENT_NETPROFIT"
      ],
      "atol": 1e-06,
      "rtol": 0.0001
    }
  },
